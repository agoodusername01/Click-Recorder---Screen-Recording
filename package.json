{
  "name": "click-recorder",
  "version": "0.2.0",
  "description": "Click Recorder - Screen Recording: an open-source, cross-platform desktop app that records clicks/actions across any application and turns them into an editable, exportable Standard Operating Procedure (SOP) document.",
  "main": "src/main.js",
  "author": "",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "test": "node test/export-import.test.js && node test/displayMap.test.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "docx": "^9.0.2",
    "mammoth": "^1.8.0",
    "node-html-parser": "^6.1.13",
    "pdfkit": "^0.15.0",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.5",
    "uiohook-napi": "^1.5.4"
  },
  "optionalDependencies": {
    "active-win": "^8.2.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "org.opensource.clickrecorder",
    "productName": "Click Recorder - Screen Recording",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
